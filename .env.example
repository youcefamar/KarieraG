# ─── Django ───────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ─── Database (PostgreSQL + pgvector) ─────────────────────
POSTGRES_DB=kariera
POSTGRES_USER=kariera
POSTGRES_PASSWORD=kariera
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://kariera:kariera@db:5432/kariera

# ─── Redis / Celery ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── JWT ──────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── AI / Embeddings (placeholder; no real key required yet) ─
AI_PROVIDER=mock
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ─── Storage (choose one; mock/local by default) ──────────
STORAGE_BACKEND=local
# S3 / Cloudinary / Firebase settings go here when enabled

# ─── pgAdmin (optional, local only) ───────────────────────
PGADMIN_DEFAULT_EMAIL=admin@kariera.local
PGADMIN_DEFAULT_PASSWORD=admin

# ─── Mobile (apps/mobile) ─────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
