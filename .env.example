# ─── Django ───────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev   # change to config.settings.prod in production
SECRET_KEY=change-me-in-production           # generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=True                                   # False in production
ALLOWED_HOSTS=localhost,127.0.0.1            # your-domain.com in production
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006  # https://your-domain.com in production

# ─── Database (PostgreSQL + pgvector) ─────────────────────
POSTGRES_DB=kariera
POSTGRES_USER=kariera
POSTGRES_PASSWORD=kariera
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://kariera:kariera@db:5432/kariera

# ─── JWT ──────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── AI / Embeddings ──────────────────────────────────────
AI_PROVIDER=mock                             # openai in production
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ─── Storage ──────────────────────────────────────────────
STORAGE_BACKEND=local                        # s3 or cloudinary in production

# S3
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1

# Cloudinary (alternative to S3)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Error tracking ───────────────────────────────────────
SENTRY_DSN=                                  # get from sentry.io (free tier)

# ─── pgAdmin (optional, local only) ───────────────────────
PGADMIN_DEFAULT_EMAIL=admin@kariera.local
PGADMIN_DEFAULT_PASSWORD=admin

# ─── Mobile (mobile/) ─────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1  # https://api.your-domain.com/api/v1 in production
